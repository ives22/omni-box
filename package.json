{
  "name": "omni-box",
  "private": true,
  "version": "0.1.0",
  "description": "Ultra-fast desktop command launcher & micro-app container built with Tauri v2, Rust, and Vue 3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri",
    "build:mac": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "install:mac": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build && rm -rf /Applications/OmniBox.app && cp -R src-tauri/target/release/bundle/macos/OmniBox.app /Applications/OmniBox.app"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-vue-next": "^0.460.0",
    "mathjs": "^13.2.0",
    "pinia": "^2.2.6",
    "pinyin-pro": "^3.26.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
